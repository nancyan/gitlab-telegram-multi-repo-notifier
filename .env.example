TELEGRAM_BOT_TOKEN=123456789:replace_me
TELEGRAM_BOT_USERNAME=your_gitlab_notifier_bot
TELEGRAM_UPDATE_MODE=polling
# Optional. URL-encode special characters in credentials.
# TELEGRAM_PROXY_URL=socks5://username:password@proxy.example.com:1080

# Public HTTPS base URL used by GitLab webhooks.
PUBLIC_BASE_URL=https://gitlab-bot.example.com

# Required only when TELEGRAM_UPDATE_MODE=webhook.
# TELEGRAM_WEBHOOK_SECRET=replace-with-a-long-random-secret

# Telegram numeric user IDs allowed to administer repositories and link users.
ADMIN_TELEGRAM_USER_IDS=123456789
LINK_CODE_TTL_MINUTES=60
DATABASE_PATH=data/notifier.sqlite3
MAX_WEBHOOK_BYTES=2097152
LOG_LEVEL=INFO

